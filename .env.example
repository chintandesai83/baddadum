# Required: Anthropic API key for AI-powered profile analysis and job matching
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: RapidAPI key for JSearch (broader job search coverage)
# Get one free at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=

# Optional: Adzuna API credentials (location-specific jobs)
# Register at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# Optional: SerpAPI key (Google Jobs scraping)
# Get one at https://serpapi.com/
SERPAPI_KEY=
